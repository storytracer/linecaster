{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BlockEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "the block's node in the plan's graph",
          "title": "Id",
          "type": "string"
        },
        "block": {
          "description": "its class name",
          "title": "Block",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "its datatrove name, where it differs from the class name",
          "title": "Name"
        },
        "class": {
          "description": "module:Class",
          "title": "Class",
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "its constructor's parameters as built (to_dict())",
          "title": "Params"
        },
        "contract": {
          "$ref": "#/$defs/Contract"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "unit (a per-unit transform) or stream",
          "title": "Shape"
        },
        "composite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the composites it sits in, outermost first, joined by /",
          "title": "Composite"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "its condition",
          "title": "When"
        },
        "provides": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provides"
        }
      },
      "required": [
        "id",
        "block",
        "class",
        "contract"
      ],
      "title": "BlockEntry",
      "type": "object"
    },
    "Contract": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "unit_out": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Out"
        },
        "reads": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reads"
        },
        "adds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adds"
        },
        "replaces": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "removes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removes"
        }
      },
      "required": [
        "role",
        "unit"
      ],
      "title": "Contract",
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "description": "the recipe edition, id@edition",
          "title": "Ref",
          "type": "string"
        },
        "pipeline": {
          "description": "the pipeline id it fills",
          "title": "Pipeline",
          "type": "string"
        },
        "sha256": {
          "description": "the edition's hash",
          "title": "Sha256",
          "type": "string"
        },
        "released": {
          "title": "Released",
          "type": "boolean"
        },
        "overrides": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "what the command line gave instead of the recipe",
          "title": "Overrides"
        }
      },
      "required": [
        "ref",
        "pipeline",
        "sha256",
        "released"
      ],
      "title": "Recipe",
      "type": "object"
    },
    "SampleListing": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "description": "what the listing's hash covers: its (item, page) ids, or its item ids (manifests: pages are known once read)",
          "enum": [
            "pages",
            "items"
          ],
          "title": "Scope",
          "type": "string"
        },
        "items": {
          "title": "Items",
          "type": "integer"
        },
        "pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pages"
        },
        "duplicates": {
          "default": 0,
          "description": "ids listed more than once (their first entry is read)",
          "title": "Duplicates",
          "type": "integer"
        },
        "manifests_read": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "manifests read to compute the sample",
          "title": "Manifests Read"
        },
        "sha256": {
          "description": "sha256 of the distinct sorted lines item_id<TAB>page_id (or item_id), each with a newline",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "items",
        "sha256"
      ],
      "title": "SampleListing",
      "type": "object"
    },
    "SampleRecord": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "description": "the rule's id (linecaster.sample/1, linecaster.data.sample)",
          "title": "Rule",
          "type": "string"
        },
        "hash": {
          "description": "the hashes that rank items and pages",
          "title": "Hash",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "N: at most this many pages in all",
          "title": "Pages"
        },
        "items": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "M: at most this many items",
          "title": "Items"
        },
        "per_item": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "K: at most this many pages of each item",
          "title": "Per Item"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "listing": {
          "$ref": "#/$defs/SampleListing"
        },
        "selected": {
          "$ref": "#/$defs/SampleSelected"
        },
        "file": {
          "description": "the sample's file in the run folder",
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "hash",
        "seed",
        "listing",
        "selected",
        "file"
      ],
      "title": "SampleRecord",
      "type": "object"
    },
    "SampleSelected": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "title": "Items",
          "type": "integer"
        },
        "pages": {
          "title": "Pages",
          "type": "integer"
        },
        "sha256": {
          "description": "sha256 of the sample's lines item_id<TAB>page_id, each with a newline, in order",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "items",
        "pages",
        "sha256"
      ],
      "title": "SampleSelected",
      "type": "object"
    },
    "Script": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "the pipeline script, relative to its git checkout (else its file name; a recipe script run from its URL: recipes/<id>.py)",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the script file's hash (sha256:<hex>)",
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "Script",
      "type": "object"
    },
    "Software": {
      "additionalProperties": false,
      "properties": {
        "linecaster": {
          "title": "Linecaster",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "packages": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Packages",
          "type": "object"
        }
      },
      "required": [
        "linecaster",
        "python"
      ],
      "title": "Software",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockEntry"
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "name",
        "tasks",
        "blocks"
      ],
      "title": "Stage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "linecaster.run-record/1",
      "default": "linecaster.run-record/1",
      "title": "Schema",
      "type": "string"
    },
    "created": {
      "description": "when the run was launched, UTC (YYYY-MM-DDTHH:MM:SSZ)",
      "title": "Created",
      "type": "string"
    },
    "script": {
      "anyOf": [
        {
          "$ref": "#/$defs/Script"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recipe": {
      "anyOf": [
        {
          "$ref": "#/$defs/Recipe"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "argv": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the command line, --env values redacted",
      "title": "Argv"
    },
    "on": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "On"
    },
    "executor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor"
    },
    "tasks": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tasks"
    },
    "workers": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workers"
    },
    "options": {
      "additionalProperties": true,
      "description": "the other parsed options",
      "title": "Options",
      "type": "object"
    },
    "pipeline": {
      "description": "the stages with their blocks, in order",
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "title": "Pipeline",
      "type": "array"
    },
    "pipeline_sha256": {
      "description": "the hash of the pipeline's functional parameters: a resume into the same run folder needs the same one",
      "title": "Pipeline Sha256",
      "type": "string"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HF Jobs: the container image",
      "title": "Image"
    },
    "dependencies": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HF Jobs: what each Job installs",
      "title": "Dependencies"
    },
    "constraints": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HF Jobs: the versions each Job resolves, from the script's lock (name==version)",
      "title": "Constraints"
    },
    "overrides": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HF Jobs: the script's override-dependencies",
      "title": "Overrides"
    },
    "sample": {
      "anyOf": [
        {
          "$ref": "#/$defs/SampleRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the sample the run read (--sample ...): the rule, its seed and limits, the listing and the sample's hashes"
    },
    "software": {
      "$ref": "#/$defs/Software"
    }
  },
  "required": [
    "created",
    "pipeline_sha256",
    "software"
  ],
  "title": "RunRecord",
  "type": "object"
}
