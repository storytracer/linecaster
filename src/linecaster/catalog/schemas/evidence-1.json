{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "linecaster.evidence/1",
      "title": "Schema",
      "type": "string"
    },
    "preset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the preset edition measured: id@edition",
      "title": "Preset"
    },
    "recipe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "or the recipe edition measured (a whole pipeline): id@edition",
      "title": "Recipe"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "for a preset measured inside a pipeline: the rest of it",
      "title": "Context"
    },
    "source": {
      "enum": [
        "own-run",
        "board",
        "card-claim",
        "vendor-benchmark"
      ],
      "title": "Source",
      "type": "string"
    },
    "dataset": {
      "description": "repo@revision, or a description for claims",
      "title": "Dataset",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "hardware": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hardware"
    },
    "software": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Software",
      "type": "object"
    },
    "run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "schema",
    "source",
    "dataset",
    "metrics",
    "date"
  ],
  "title": "Evidence",
  "type": "object"
}
